rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Commitments collection: strictly isolated to the authenticated owner
    match /commitments/{commitmentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid && (resource == null || resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid);
    }

    // Payments collection: strictly isolated to the authenticated owner
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid && (resource == null || resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid);
    }
  }
}

