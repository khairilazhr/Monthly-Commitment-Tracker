rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Generic Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Commitment Validation
    function isValidCommitment(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'category', 'amount', 'durationMonths', 'startMonth', 'dueDay', 'createdAt'])
        && data.keys().size() <= 12
        && isOwner(data.userId)
        && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && (data.amount is int || data.amount is float) && data.amount >= 0
        && data.durationMonths is int && data.durationMonths >= 1 && (data.durationMonths <= 360 || data.durationMonths == 999)
        && data.startMonth is string && data.startMonth.matches('^[0-9]{4}-[0-9]{2}$')
        && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
        && data.createdAt is string
        && (!data.keys().hasAll(['notes']) || (data.notes is string && data.notes.size() <= 500))
        && (!data.keys().hasAll(['user']) || (data.user is string && data.user.size() <= 50));
    }

    // Payment Validation
    function isValidPayment(data) {
      return data.keys().hasAll(['id', 'commitmentId', 'userId', 'month', 'status'])
        && data.keys().size() <= 6
        && isOwner(data.userId)
        && isValidId(data.id)
        && isValidId(data.commitmentId)
        && data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && data.status is string && (data.status == 'paid' || data.status == 'pending')
        && (!data.keys().hasAll(['paidAt']) || (data.paidAt is string));
    }

    // Rules for commitments
    match /commitments/{commitmentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(commitmentId) 
        && request.resource.data.id == commitmentId
        && isValidCommitment(request.resource.data);
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && isValidCommitment(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for payments
    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(paymentId) 
        && request.resource.data.id == paymentId
        && isValidPayment(request.resource.data);
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && isValidPayment(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
